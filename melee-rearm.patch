diff --git a/L4D2VR/config.txt b/L4D2VR/config.txt
index ec45bc5..1909f36 100644
--- a/L4D2VR/config.txt
+++ b/L4D2VR/config.txt
@@ -494,6 +494,15 @@ MeleeSwingMinTipTravel=0.43
 MeleeSwingMinHandTravel=0.13
 // Hits pulse the controller at full strength (haptics_config.txt melee.hit); this also pulses when a swing starts.
 MeleeSwingStartHaptics=false
+// Swing re-arm gates. After a swing, the blade must slow below MeleeSwingRestSpeed (m/s) for MeleeSwingRestSeconds
+// before the next swing can start, and at least MeleeSwingCooldown seconds must have passed since the last swing
+// started. A swing itself ends when the blade falls below MeleeSwingReleaseSpeed or the hand below
+// MeleeSwingReleaseHandSpeed. Raise MeleeSwingRestSpeed (for example 3.0) to chain flowing, continuous slashes.
+MeleeSwingRestSpeed=1.5
+MeleeSwingRestSeconds=0.02
+MeleeSwingReleaseSpeed=2.5
+MeleeSwingReleaseHandSpeed=1.25
+MeleeSwingCooldown=0.35
 // Keep the headset fed with frames during loading screens and chapter transitions.
 LoadingFramePumpEnabled=true
 LoadingFramePumpStallMs=150
